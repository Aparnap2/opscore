# OpsCore Live Provider Test Configuration
# Copy to config/live.env and fill in real credentials.
# NEVER commit config/live.env to version control.

# LLM Provider (OpenRouter - free tier)
OPENROUTER_API_KEY=sk-or-v1-<your-key>

# OCR Provider (Sarvam)
SARVAM_API_KEY=<your-sarvam-api-key>

# Test limits
LIVE_TESTS_MAX_CALLS=3
LIVE_TESTS_TIMEOUT_SECONDS=120
