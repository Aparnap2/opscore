# OpsCore v2.0 - Go + Azure Serverless Configuration
# Copy this to .env and fill in values (DO NOT COMMIT .env)

# =============================================================================
# Azure Resources (from Azure Portal)
# =============================================================================
COSMOS_ENDPOINT=https://<your-cosmos>.documents.azure.com:443/
COSMOS_KEY=<your-cosmos-primary-key>
COSMOS_DATABASE=opscore

# Storage account connection string from Azure Portal
STORAGE_CONNECTION=DefaultEndpointsProtocol=https;AccountName=<storage>;AccountKey=<key>;EndpointSuffix=core.windows.net

# App Insights instrumentation key
APPINSIGHTS_KEY=<your-appinsights-key>

# =============================================================================
# AI Providers
# =============================================================================
SARVAM_AI_API_KEY=<your-sarvam-api-key>

# =============================================================================
# Slack HITL (Human-in-the-Loop)
# =============================================================================
SLACK_BASE_URL=https://slack.com
SLACK_BOT_TOKEN=xoxb-<your-bot-token>
SLACK_SIGNING_SECRET=<your-signing-secret>
SLACK_HITL_CHANNEL=<your-channel-id>

# =============================================================================
# Environment
# =============================================================================
APP_ENV=production  # or 'development' for local testing